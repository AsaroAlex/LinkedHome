# Optional external PostgreSQL. Local bootstrap generates ignored configuration instead.
# DATABASE_URL=postgresql://user:password@127.0.0.1:5432/soglia
# APP_ORIGIN=http://127.0.0.1:3000
# HOST=127.0.0.1
# PORT=3000
# APP_ENV=local
# Synthetic hosted preview: APP_ENV=preview, MAIL_TRANSPORT=disabled,
# explicit HTTPS APP_ORIGIN and external DATABASE_URL. No real accounts/mail.
# MAIL_TRANSPORT=local

# Property photos: local development stores private images in .local/property-photos.
# Deployed environments require private S3-compatible object storage.
# PHOTO_STORAGE=s3
# S3_ENDPOINT=https://YOUR-S3-ENDPOINT
# S3_REGION=auto
# S3_BUCKET=YOUR-BUCKET
# S3_ACCESS_KEY_ID=YOUR-ACCESS-KEY
# S3_SECRET_ACCESS_KEY=YOUR-SECRET
# S3_FORCE_PATH_STYLE=false
# Railway: reference linkedhome-photos.ENDPOINT / REGION / BUCKET /
# ACCESS_KEY_ID / SECRET_ACCESS_KEY in both web and maintenance services.

# Interactive development: copy only needed settings to .env.development.local.
# npm run dev loads that ignored file; shell variables take precedence.
# DEV_HOST=127.0.0.1
# DEV_PORT=3000
# DEV_API_PORT=3001
# For a forwarded cloud preview, use npm run dev:cloud and its exact browser origin:
# APP_ORIGIN=https://YOUR-PRIVATE-PREVIEW-HOST
# Codespaces derives the origin automatically; only the frontend port is forwarded.

# Staging/deployment: configure these in the hosting secret manager, never commit values.
# APP_ENV=staging
# APP_ORIGIN=https://YOUR-APP-HOST
# DATABASE_URL=postgresql://user:password@PRIVATE-DB-HOST:5432/linkedhome
# MAIL_TRANSPORT=smtp
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=465
# SMTP_USER=YOUR-SMTP-LOGIN
# SMTP_PASSWORD=YOUR-SMTP-KEY
# MAIL_FROM=no-reply@YOUR-VERIFIED-DOMAIN
# TRUST_PROXY=false
# Only replace false with independently verified upstream IPs/CIDRs.
# For PostgreSQL across an untrusted network use sslmode=verify-full and trusted CA.

# Proposed future domain: linkedhome.eu (not purchased). See docs/operations/domain-setup.md.
# linkedhome.com is already registered; linkedhome.it is an optional defensive domain.
# After purchase, DNS, HTTPS and verified Brevo sender only:
# Production APP_ORIGIN=https://linkedhome.eu
# Staging APP_ORIGIN=https://staging.linkedhome.eu
# MAIL_FROM=no-reply@linkedhome.eu
# Until then use the working hosting origin and a sender domain you control.
