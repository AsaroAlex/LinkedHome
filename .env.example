# Optional external PostgreSQL. Local bootstrap generates ignored configuration instead.
# DATABASE_URL=postgresql://user:password@127.0.0.1:5432/soglia
# APP_ORIGIN=http://127.0.0.1:3000
# HOST=127.0.0.1
# PORT=3000
# APP_ENV=local
# MAIL_TRANSPORT=local

# Staging/deployment: configure these in the hosting secret manager, never commit values.
# APP_ENV=staging
# APP_ORIGIN=https://YOUR-APP-HOST
# DATABASE_URL=postgresql://user:password@PRIVATE-DB-HOST:5432/linkedhome
# MAIL_TRANSPORT=smtp
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=465
# SMTP_USER=YOUR-SMTP-LOGIN
# SMTP_PASSWORD=YOUR-SMTP-KEY
# MAIL_FROM=no-reply@YOUR-VERIFIED-DOMAIN
# TRUST_PROXY=false
# Only replace false with independently verified upstream IPs/CIDRs.
# For PostgreSQL across an untrusted network use sslmode=verify-full and trusted CA.
